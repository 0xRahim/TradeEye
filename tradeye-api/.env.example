# Copy to .env.local and fill in real values (never commit .env.local)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Upstream price feed base URL (fallback feed; no key required)
BIQUOTE_BASE_URL=https://biquote.io

# OANDA v20 (default feed). Key + account stay server-side — never commit
# real values, never expose via NEXT_PUBLIC_*. OANDA_ENV must match where
# the token was made ("practice" or "live"). OANDA_ACCOUNT_ID is required
# for /api/quote (pricing endpoint); history works with the key alone.
OANDA_API_KEY=your-oanda-token-here
OANDA_ENV=practice
OANDA_ACCOUNT_ID=101-001-XXXXXXX-001
